<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 使用者手冊由 GET /manual 直接讀 docs/ 底下的檔案回傳（見 Program.cs）。
         docs/ 不在 wwwroot 底下，dotnet publish 預設不會帶出去，這裡明列讓它跟著發佈。 -->
    <Content Include="docs\使用者手冊.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- IIS 的 stdout log 資料夾（第 82 批，見 web.config）。
         ⚠️ ANCM 不會自己建這個資料夾，不存在時 log 是**靜靜不產生**的 ——
         所以要靠這個 .gitkeep 讓 dotnet publish 把 logs\ 一起帶出去。 -->
    <Content Include="logs\.gitkeep" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- 第 246 批：每台主機自己的設定檔（appsettings.{環境}.local.json）不跟著發佈出去 ——
         公司桌機的「測試區」標籤不可以被複製到 IIS 正式區 -->
    <Content Update="appsettings.*.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Windows 驗證 (Negotiate/NTLM)，供稽核表的「異動人員」自動帶入登入者。
         版本對齊 C:\Gantt 專案（同一台內網主機、同為 net9.0），⚠ 維持 9.0.x 不跳 10.x。
         2026-10-18 第 234 批：9.0.18 → 9.0.21（CVE-2026-70179，只在開 LDAP 查群組時成立、本專案沒開；升級是為了弱點掃描）。 -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="9.0.21" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

</Project>
